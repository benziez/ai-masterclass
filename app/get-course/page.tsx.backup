// Force dynamic rendering
export const dynamic = 'force-dynamic'

// Simple lazy loading hook
function useLazyLoad() {
  const [isVisible, setIsVisible] = useState(false)
  const [hasLoaded, setHasLoaded] = useState(false)
  
  useEffect(() => {
    if (!hasLoaded) {
      const timer = setTimeout(() => {
        setIsVisible(true)
        setHasLoaded(true)
      }, 100) // Small delay for smooth loading
      
      return () => clearTimeout(timer)
    }
  }, [hasLoaded])
  
  return isVisible
}

// Progress Bar Component
function ProgressBar({ onSpotsChange }: { onSpotsChange?: (spots: number) => void }) {
  const [spotsLeft, setSpotsLeft] = useState(7)
  const totalSpots = 50

  useEffect(() => {
    const timer = setInterval(() => {
      setSpotsLeft(prev => {
        if (prev > 1) {
          const newSpots = prev - Math.floor(Math.random() * 1) // Random decrease of 0 or 1
          onSpotsChange?.(newSpots)
          return newSpots
        }
        return prev
      })
    }, 30000) // Update every 30 seconds

    return () => clearInterval(timer)
  }, [onSpotsChange])

  const percentageLeft = (spotsLeft / totalSpots) * 100

  return (
    <div className="flex items-center gap-2">
      <div className="w-16 h-2 bg-red-200 rounded-full overflow-hidden">
        <div 
          className="h-full bg-red-500 rounded-full transition-all duration-500"
          style={{ width: `${percentageLeft}%` }}
        ></div>
      </div>
    </div>
  )
}

